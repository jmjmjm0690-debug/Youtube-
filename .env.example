# ==============================================================================
# 収益化特化型 YouTube 急上昇トレンド解説＆考察動画 自動生成・自動公開システム
# 環境変数設定テンプレート (.env.example -> .env にコピーして使用)
# ==============================================================================

# タイムゾーン
TZ=Asia/Tokyo

# ------------------------------------------------------------------------------
# 1. Gemini API 設定
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
# 台本・深掘り考察生成用のメインモデル (gemini-3.8-flash 推奨 / 自動フォールバック対応)
GEMINI_MODEL=gemini-3.8-flash
# トレンド一次スコアリング・補助処理用の高速モデル
GEMINI_FAST_MODEL=gemini-3.6-flash

# ------------------------------------------------------------------------------
# 2. VOICEVOX Engine 設定
# ------------------------------------------------------------------------------
# Docker Compose 実行時は http://voicevox:50021、ローカル/GitHub Actions は http://127.0.0.1:50021
VOICEVOX_BASE_URL=http://127.0.0.1:50021

# ------------------------------------------------------------------------------
# 3. YouTube Data API v3 (OAuth 2.0) 設定
# ------------------------------------------------------------------------------
YOUTUBE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_google_oauth_client_secret
YOUTUBE_REFRESH_TOKEN=your_oauth_refresh_token

# 公開ステータス: public (本番:完全自動公開) / unlisted (限定公開テスト) / private (非公開テスト)
YOUTUBE_PRIVACY_STATUS=public

# YouTube カテゴリID (25: ニュースと政治, 28: 科学と技術, 22: ブログ/解説)
YOUTUBE_CATEGORY_ID=25

# ------------------------------------------------------------------------------
# 4. 通知・オプション設定 (任意)
# ------------------------------------------------------------------------------
# Discord または Slack の Incoming Webhook URL (空欄の場合は通知スキップ)
WEBHOOK_URL=

# 手動トピック強制指定 (空欄の場合は急上昇トレンドから自動選定)
FORCE_TOPIC_KEYWORD=

# ドライラン設定 (true にすると動画生成まで実行し YouTube アップロードをスキップ)
DRY_RUN=false
